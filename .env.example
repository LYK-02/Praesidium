# -----------------------------------------------------------------------------
# Praesidium — Environment Configuration Template
# NOTE: Never commit real credentials or .env files.
# -----------------------------------------------------------------------------

# PayPal Configuration (Sandbox Only)
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Webhook Setup Steps:
# 1. Start tunnel: `pnpm tunnel` (provides https://<id>.trycloudflare.com)
# 2. Set PUBLIC_BASE_URL to your active tunnel URL below
# 3. Run: `pnpm webhook:register` (registers or updates sandbox webhook)
# 4. Copy the returned Webhook ID and paste it here:
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
ALLOW_LIVE=false

# LLM Configuration (NVIDIA NIM)
# Get API key from https://build.nvidia.com/
LLM_PROVIDER=nvidia-nim
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Application & Database
# When testing live webhooks, set this to your cloudflared tunnel URL:
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=file:./praesidium.db

# Authentication & Security
ADMIN_PASSWORD=change_this_secure_admin_password
SESSION_SECRET=change_this_to_a_random_32_char_secret_key
